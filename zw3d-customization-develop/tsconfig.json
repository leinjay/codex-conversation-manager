{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "lib": ["ES2022"],
    "rootDir": "src", "outDir": "dist", "strict": true,
    "esModuleInterop": true, "sourceMap": true, "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src/**/*.ts"]
}
